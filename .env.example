# ===========================================
# DDNet Bingo - Environment Configuration
# ===========================================

# PayloadCMS
PAYLOAD_SECRET=your-random-secret-min-32-chars
DATABASE_URI=mongodb://mongo:27017/ddnet

# Next.js
NEXT_PUBLIC_SERVER_URL=https://your-domain.com

# Cloudinary (media storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=ddnet

# Google OAuth
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_SECRET=your-random-auth-secret

# Bot System
BACKEND_SECRET=your-random-bot-secret
USE_MOCK_BOT=false
MAX_BOTS=10
MAX_CONCURRENT_BOTS=4

# Bot Docker image (for DooD)
BOT_DOCKER_IMAGE=your-dockerhub-username/ddnet-bot:latest

# Game Configuration
BINGO_POLL_INTERVAL_MS=5000
MAX_ACTIVE_GAMES_PER_USER=1

# Verification
VERIFICATION_SERVERS=["ger1.ddnet.org:8303"]
VERIFICATION_TTL_MS=600000

# Race
RACE_SERVERS=[]

# Push Notifications (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:your-email@example.com

# Docker Hub (for CI/CD)
DOCKERHUB_USERNAME=
